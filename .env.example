NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
NEXT_PUBLIC_SITE_URL=https://your-production-domain.example
NEXT_PUBLIC_DISCORD_AUTH_ENABLED=false
# Public Discord application ID used to build the owner-facing bot install link.
NEXT_PUBLIC_DISCORD_BOT_CLIENT_ID=1542897675995844650
DISCORD_BOT_TOKEN=your-discord-bot-token
OPENAI_API_KEY=sk-your-server-side-key
OPENAI_REALTIME_MODEL=gpt-realtime-2.1-mini
OPENAI_ANALYSIS_MODEL=gpt-5-mini
OPENAI_AUDIO_ANALYSIS_MODEL=gpt-audio-1.5

# Feedback email delivery through Resend. Verify dexlyy.com in Resend first.
RESEND_API_KEY=re_your-server-side-key
RESEND_FROM_EMAIL=Dexlyy Feedback <feedback@dexlyy.com>

# PayPal: public client ID and public plan IDs are used by the browser checkout.
NEXT_PUBLIC_PAYPAL_CLIENT_ID=your-paypal-client-id
NEXT_PUBLIC_PAYPAL_PLAN_STARTER=P-your-starter-plan-id
NEXT_PUBLIC_PAYPAL_PLAN_SMALL=P-your-small-plan-id
NEXT_PUBLIC_PAYPAL_PLAN_MEDIUM=P-your-medium-plan-id
NEXT_PUBLIC_PAYPAL_PLAN_PRO=P-your-pro-plan-id
NEXT_PUBLIC_PAYPAL_PLAN_ULTRA=P-your-ultra-plan-id
NEXT_PUBLIC_PAYPAL_PLAN_STARTER_YEARLY=P-your-starter-yearly-plan-id
NEXT_PUBLIC_PAYPAL_PLAN_SMALL_YEARLY=P-your-small-yearly-plan-id
NEXT_PUBLIC_PAYPAL_PLAN_MEDIUM_YEARLY=P-your-medium-yearly-plan-id
NEXT_PUBLIC_PAYPAL_PLAN_PRO_YEARLY=P-your-pro-yearly-plan-id
NEXT_PUBLIC_PAYPAL_PLAN_ULTRA_YEARLY=P-your-ultra-yearly-plan-id

# PayPal and Supabase secrets are server-only. Never prefix these with NEXT_PUBLIC_.
PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_CLIENT_SECRET=your-paypal-client-secret
PAYPAL_PLAN_STARTER=P-your-starter-plan-id
PAYPAL_PLAN_SMALL=P-your-small-plan-id
PAYPAL_PLAN_MEDIUM=P-your-medium-plan-id
PAYPAL_PLAN_PRO=P-your-pro-plan-id
PAYPAL_PLAN_ULTRA=P-your-ultra-plan-id
PAYPAL_PLAN_STARTER_YEARLY=P-your-starter-yearly-plan-id
PAYPAL_PLAN_SMALL_YEARLY=P-your-small-yearly-plan-id
PAYPAL_PLAN_MEDIUM_YEARLY=P-your-medium-yearly-plan-id
PAYPAL_PLAN_PRO_YEARLY=P-your-pro-yearly-plan-id
PAYPAL_PLAN_ULTRA_YEARLY=P-your-ultra-yearly-plan-id
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_WEBHOOK_ID=your-paypal-webhook-id
# Use one Supabase Secret key (sb_secret_…) here, never the publishable key.
SUPABASE_SECRET_KEY=your-supabase-secret-key
# Used by the daily application-history cleanup endpoint. Generate a long random value.
CRON_SECRET=your-long-random-cron-secret
# Legacy alternative only; leave unset when SUPABASE_SECRET_KEY is configured.
# SUPABASE_SERVICE_ROLE_KEY=your-legacy-service-role-key
