  "storage_update": [
    {
      "cmd": "UPDATE",
      "qual": "((bucket_id = 'interview-recordings'::text) AND (EXISTS ( SELECT 1\n   FROM (interview_sessions i\n     JOIN applications a ON ((a.id = i.application_id)))\n  WHERE (((i.server_id)::text = (storage.foldername(objects.name))[1]) AND ((i.id)::text = (storage.foldername(objects.name))[2]) AND (a.applicant_user_id = ( SELECT auth.uid() AS uid))))))",
      "roles": [
        "authenticated"
      ],
      "tablename": "objects",
      "permissive": "PERMISSIVE",
      "policyname": "participants update interview recordings",
      "schemaname": "storage",
      "with_check": "(bucket_id = 'interview-recordings'::text)"
    }
  ]
}
