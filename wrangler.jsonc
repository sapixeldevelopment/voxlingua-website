{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dexlyy",
  "compatibility_date": "2026-08-31",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "worker.ts",
  "triggers": { "crons": ["*/15 * * * *"] },
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  "cache": {
    "enabled": true
  }
}
